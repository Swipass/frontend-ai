# ==============================================================================
# Swipass Frontend environment (Vite)
# Copy to .env and fill in real values:  cp .env.example .env
# Only VITE_-prefixed vars are exposed to the browser. Put NO secrets here;
# these are all publishable/public values by design.
# ==============================================================================

# Backend base URL the app calls.
# Local dev: leave as-is; vite.config proxies /v1 /platform /admin /health to :8000.
# Production: your deployed backend origin, e.g. https://api.swipass.com
# [REQUIRED in production]
VITE_API_URL=http://localhost:8000

# Auth is self-hosted OAuth handled by the backend (Google + GitHub); the
# dashboard sign-in buttons link to {VITE_API_URL}/auth/login/{google|github}.
# No auth key is needed in the frontend.

# WalletConnect / Reown project id (RainbowKit + wagmi; needed for mobile wallets).
# https://cloud.reown.com (formerly cloud.walletconnect.com) -> create project ->
#   copy the Project ID.
# [REQUIRED]
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Optional per-chain RPC overrides (RainbowKit/wagmi transports). Leave blank to
# use the built-in public endpoints. For production reliability, point these at
# your own Alchemy/Infura URLs (https://dashboard.alchemy.com).
# [OPTIONAL]
VITE_RPC_URL_ETHEREUM=
VITE_RPC_URL_ARBITRUM=
VITE_RPC_URL_BASE=
VITE_RPC_URL_OPTIMISM=
VITE_RPC_URL_POLYGON=

# Environment flag.
VITE_ENVIRONMENT=development             # development | production
