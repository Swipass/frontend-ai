# ==============================================================================
# Swipass Frontend environment (Vite)
# Copy to .env and fill in real values:  cp .env.example .env
# Only VITE_-prefixed vars are exposed to the browser. Put NO secrets here;
# these are all publishable/public values by design.
# ==============================================================================

# Backend base URL the app calls.
#
# Local dev: leave it as it is. vite.config proxies /v1 /platform /admin /health
# and the /auth API paths to localhost:8000.
#
# Production: this file does NOT set it. Vite inlines VITE_ variables into the
# bundle at build time, so the deployed value comes from the build environment,
# which for this project is the Vercel project settings. Changing it there needs
# a redeploy to take effect; editing this file changes nothing that is live.
#
# Wherever you point it, three values have to agree or sign-in and the app page
# will fail in ways that look unrelated:
#   1. this VITE_API_URL                 -> https://<your-api-domain>
#   2. the backend's ALLOWED_ORIGINS     -> the frontend origin, e.g.
#                                           https://www.swipass.com
#   3. the backend's OAUTH_REDIRECT_BASE_URL and the redirect URI registered
#      with Google and GitHub -> https://<your-api-domain>/auth/callback/<provider>
#
# The app reads its chains, tokens and fee rates from this API, so if it is
# wrong or unreachable the app page says "Networks unavailable" rather than
# guessing. The landing page and docs keep working either way.
VITE_API_URL=http://localhost:8000

# Auth is self-hosted OAuth handled by the backend (Google + GitHub); the
# dashboard sign-in buttons link to {VITE_API_URL}/auth/login/{google|github}.
# No auth key is needed in the frontend.

# WalletConnect / Reown project id, for RainbowKit and wagmi.
#   https://cloud.reown.com  ->  create a project  ->  copy the Project ID.
# Free. Without it the app still loads and browser wallets (MetaMask and the
# like) work fully, but WalletConnect is off, which in practice means mobile
# wallets cannot connect.
VITE_WALLETCONNECT_PROJECT_ID=

# There are no per-chain RPC settings here any more. The wallet is configured
# from GET /v1/chains, which returns each supported chain with its id, native
# asset, explorer and a public RPC. That way enabling a provider that adds a
# chain makes it switchable in the wallet with no frontend change, and there is
# one list to keep correct instead of two. To change which RPC the wallet uses,
# change it in the backend chain registry.

# Environment flag.
VITE_ENVIRONMENT=development             # development | production
